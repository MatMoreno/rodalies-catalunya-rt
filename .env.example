# Claves gratuitas de developer.tmb.cat, solo para los buses URBANOS de Barcelona
# (tiempo real de iBus). Sin ellas la app funciona igual: buscador, tableros y
# paradas cercanas siguen enteros con los interurbanos de la Generalitat.
TMB_APP_ID=
TMB_APP_KEY=

# Opcionales (valores por defecto entre paréntesis):
# GTFS_URL=   (feed interurbano de analisi.transparenciacatalunya.cat)
# GTFS_DIR=   (data/gtfs)
# GTFS_DIAS=  (7 · cada cuántos días se comprueba si hay horario nuevo)
